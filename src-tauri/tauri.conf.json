{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lotus",
  "mainBinaryName": "Lotus",
  "version": "../package.json",
  "identifier": "io.lotus.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Lotus",
        "width": 1350,
        "height": 720,
        "center": true,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Lotus: a Warframe companion app",
    "copyright": "MIT licence. Warframe artwork © Digital Extremes Ltd.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEMzZGRDcyM0FFMzRBNEYKUldSUFN1TTZjdjAyTFJtR0gvbE8zRjZSNmxjTG1NZWFOZzhjeG9LZ1plQmt2Q0xreG0za3BQZDYK",
      "endpoints": [
        "https://github.com/t-2ddy/Lotus-Warframe-Companion-App/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
